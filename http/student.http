PUT {{baseUrl}}/student/days/2026-08-26/exercises/{{diaAsignado.response.body.$.bloques[0].exercises[1].id}}/sets/1
Authorization: Bearer {{loginAlumna.response.body.token}}
Content-Type: application/json

{ "completed": true, "loadUsed": "50 kg", "rpe": "JUSTA" }

###
PUT {{baseUrl}}/student/days/2026-08-26/exercises/{{diaAsignado.response.body.$.bloques[0].exercises[1].id}}/sets/2
Authorization: Bearer {{loginAlumna.response.body.token}}
Content-Type: application/json

{ "completed": true, "loadUsed": "50 kg", "rpe": "JUSTA" }

###
PUT {{baseUrl}}/student/days/2026-08-26/exercises/{{diaAsignado.response.body.$.bloques[0].exercises[1].id}}/sets/3
Authorization: Bearer {{loginAlumna.response.body.token}}
Content-Type: application/json

{ "completed": true, "loadUsed": "50 kg", "rpe": "JUSTA" }

###
PUT {{baseUrl}}/student/days/2026-08-26/exercises/{{diaAsignado.response.body.$.bloques[0].exercises[1].id}}/sets/4
Authorization: Bearer {{loginAlumna.response.body.token}}
Content-Type: application/json

{ "completed": true, "loadUsed": "50 kg", "rpe": "AL_LIMITE" }


### 20. Confirmar: bloque A completo, bloquesCompletos:1, día no completo
### todavía (falta el bloque B)
GET {{baseUrl}}/student/days/2026-08-26
Authorization: Bearer {{loginAlumna.response.body.token}}
