// Esquema de datos de "Entrená con Chino"
// Mapeado directo desde los prototipos (app-alumno_1.html y panel-coach_1.html).
// DB: PostgreSQL. Ajustá tipos/índices según haga falta al avanzar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// USUARIOS Y ROLES
// ─────────────────────────────────────────────────────────────

enum Role {
  COACH
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  initials     String? // "MS", "CD" — para los avatares de los prototipos
  createdAt    DateTime @default(now())

  // Si es alumno, su perfil de entrenamiento
  studentProfile StudentProfile?

  // Rutinas que creó (si es coach)
  routinesCreated Routine[] @relation("CoachRoutines")

  // Mensajes que mandó
  messagesSent Message[] @relation("MessageSender")
}

model StudentProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId       String? // qué coach lo lleva
  plan          String? // "Hipertrofia · 5 días", "Iniciación · 3 días", ...
  planStartDate DateTime?
  planActive    Boolean   @default(true)
  nextPayment   DateTime?

  assignments Assignment[]
  sessions    Session[]
  records     PersonalRecord[]
  messages    Message[]        @relation("StudentMessages")
}

// ─────────────────────────────────────────────────────────────
// BIBLIOTECA DE RUTINAS  (rutina → bloques → ejercicios)
// ─────────────────────────────────────────────────────────────

enum RoutineType {
  FUERZA
  METABOLICO
  MOVILIDAD
}

model Routine {
  id        String      @id @default(cuid())
  coachId   String
  coach     User        @relation("CoachRoutines", fields: [coachId], references: [id])
  name      String // "Tren superior — Fuerza"
  type      RoutineType
  createdAt DateTime    @default(now())

  blocks      Block[]
  assignments Assignment[]
  sessions    Session[]
}

model Block {
  id         String  @id @default(cuid())
  routineId  String
  routine    Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  letter     String // "A", "B", "C", "D"
  name       String // "Fuerza principal"
  mode       String? // "Series rectas", "AMRAP 12:00", "Circuito · 2 vueltas"
  estMinutes Int     @default(0)
  note       String? @db.Text // "Nota de Chino" para el alumno
  orderIndex Int

  exercises Exercise[]
}

model Exercise {
  id              String       @id @default(cuid())
  blockId         String
  block           Block        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  name            String // "Press de banca"
  // Movilidad / Fuerza / Metabólico ahora también se define por ejercicio, no
  // sólo por rutina. Reusa el enum de Routine.type: el nombre quedó como
  // RoutineType por historia, renombrarlo tocaría todo el código sin ganar nada.
  type            RoutineType? // null en los ejercicios cargados antes de este cambio
  sets            Int // series
  // Un ejercicio se mide por repeticiones O por tiempo, nunca por las dos.
  // La regla no se puede expresar en Prisma: va como validación en
  // POST/PATCH /coach/routines y como CHECK en la migración.
  // reps / durationSeconds / load son el valor SUGERIDO de la rutina, y quedan
  // vacíos en las rutinas genéricas: el valor que ve cada alumno puede estar
  // pisado por un AssignmentExercise del día. Ver ese modelo.
  reps            String? // "8", "máx", "12 por lado" — texto a propósito
  durationSeconds Int? // plancha 45s, bici 5 min…
  load            String? // "60 kg", "Banda", "—"
  restSeconds     Int          @default(0)
  orderIndex      Int

  setLogs             SetLog[]
  assignmentOverrides AssignmentExercise[]
}

// ─────────────────────────────────────────────────────────────
// ASIGNACIÓN  (qué rutina va a qué alumno, qué día)
// Reemplaza el objeto `semana` de los prototipos.
// ─────────────────────────────────────────────────────────────

model Assignment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routineId String
  routine   Routine        @relation(fields: [routineId], references: [id])
  date      DateTime       @db.Date // el día concreto asignado

  session           Session?
  exerciseOverrides AssignmentExercise[]

  @@unique([studentId, date]) // un alumno, una rutina por día
  @@index([studentId, date])
}

// Personalización de un ejercicio para UN alumno en UN día.
//
// Chino arma la rutina genérica (sin peso ni repeticiones) y completa los
// valores recién cuando se la asigna a alguien. Sin esto, cambiarle el peso a
// Mica se lo cambiaba a TODOS los alumnos que tuvieran esa rutina asignada,
// porque load y reps viven en Exercise, o sea dentro de la rutina.
//
// GET /student/days/:date resuelve cuál gana: si hay override para ese día,
// gana el override; si no, el valor sugerido de la rutina.
model AssignmentExercise {
  id              String     @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reps            String?
  load            String?
  durationSeconds Int?

  @@unique([assignmentId, exerciseId])
}

// ─────────────────────────────────────────────────────────────
// HISTORIAL  (se arma solo con lo que el alumno marca)
// ─────────────────────────────────────────────────────────────

enum Sensation {
  FACIL
  JUSTA
  AL_LIMITE
  NO_PUDE
}

enum SessionStatus {
  SIN_HACER
  A_MEDIAS
  COMPLETO
}

model Session {
  id              String         @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routineId       String
  routine         Routine        @relation(fields: [routineId], references: [id])
  assignmentId    String?        @unique
  assignment      Assignment?    @relation(fields: [assignmentId], references: [id])
  date            DateTime       @db.Date
  durationMinutes Int?
  sensation       Sensation?
  status          SessionStatus  @default(SIN_HACER)
  blocksDone      Int            @default(0)
  blocksTotal     Int            @default(0)
  createdAt       DateTime       @default(now())

  setLogs SetLog[]

  @@index([studentId, date])
}

model SetLog {
  id         String     @id @default(cuid())
  sessionId  String
  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  completed  Boolean    @default(false)
  loadUsed   String? // lo que el alumno realmente usó ese día
  repsDone   Int? // las repeticiones que realmente hizo (Exercise.reps es el plan)
  rpe        Sensation? // "cómo te salió" por serie
  note       String? // comentario opcional cuando usó una carga distinta

  @@unique([sessionId, exerciseId, setNumber])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────
// MARCAS  (progresión por ejercicio — la pantalla "Tus marcas")
// ─────────────────────────────────────────────────────────────

model PersonalRecord {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exerciseName String // "Press de banca"
  value        String // "62,5 kg"
  note         String? // "+7,5 kg en 4 semanas"
  updatedAt    DateTime       @updatedAt

  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────
// CHAT  (coach ↔ alumno)
// ─────────────────────────────────────────────────────────────

model Message {
  id        String         @id @default(cuid())
  studentId String // el hilo pertenece a un alumno
  student   StudentProfile @relation("StudentMessages", fields: [studentId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User           @relation("MessageSender", fields: [senderId], references: [id])
  body      String         @db.Text
  sentAt    DateTime       @default(now())
  readAt    DateTime?

  @@index([studentId, sentAt])
}
