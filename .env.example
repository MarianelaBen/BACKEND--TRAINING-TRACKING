# Copiá como .env y completá. El .env real NO va a git.
# En producción, estos valores van en el panel de Coolify.

# PostgreSQL — en Coolify usás la URL del recurso de base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/chino?schema=public"

# Secreto para firmar sesiones/tokens. Largo y aleatorio.
SESSION_SECRET="cambiar-por-un-string-largo-y-aleatorio"

# Origen del frontend permitido para CORS.
# En dev suele ser http://localhost:5173 (puerto por defecto de Vite).
# En prod, la URL pública del front (ej: https://app.entrenaconchino.com)
CORS_ORIGIN="http://localhost:5173"

PORT=3000
NODE_ENV=development
